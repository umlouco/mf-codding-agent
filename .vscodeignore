.vscode/**
.github/**
.claude/**
core/**
scripts/**
src/**
node_modules/**
out/**/*.map
**/*.ts
**/tsconfig.json
esbuild.mjs
**/*.ps1
.gitignore
.env
.mcp.json
.mfagent/**

# Keep only the binary for the target platform when packaging per-platform.
!out/extension.js
!media/**
!bin/**
# Note: the negation above is global in vsce — a later `bin/**/*.old` does NOT
# re-exclude. Anything dropped into bin/ ships, so build-core.mjs parks
# displaced binaries in the temp dir rather than beside their replacement.

# Kilocode's agent-manager folder, with its own node_modules — never part of the extension.
.kilo/**
