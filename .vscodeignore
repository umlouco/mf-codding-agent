.vscode/**
.github/**
.claude/**
core/**
scripts/**
src/**
node_modules/**
out/**
**/*.ts
**/tsconfig.json
esbuild.mjs
**/*.ps1
.gitignore
.env
.mcp.json
.mfagent/**

# Ship runtime binaries, never arbitrary test executables left in bin/.
bin/**
!out/extension.js
!media/**
!bin/mfcore
!bin/mfcore.exe
!bin/mfagent-mcp
!bin/mfagent-mcp.exe
!bin/win32-x64/mfcore.exe
!bin/win32-x64/mfagent-mcp.exe
!bin/win32-arm64/mfcore.exe
!bin/win32-arm64/mfagent-mcp.exe
!bin/linux-x64/mfcore
!bin/linux-x64/mfagent-mcp
!bin/linux-arm64/mfcore
!bin/linux-arm64/mfagent-mcp
!bin/darwin-x64/mfcore
!bin/darwin-x64/mfagent-mcp
!bin/darwin-arm64/mfcore
!bin/darwin-arm64/mfagent-mcp

# Kilocode's agent-manager folder, with its own node_modules — never part of the extension.
.kilo/**

# The Playwright runtime shipped with the extension, built by
# scripts/bundle-playwright.mjs. It is what makes browser testing work against
# a project that owns no test dependencies, so it must survive the
# node_modules/** rule above.
!runtime/**
runtime/**/*.md
runtime/**/.bin/**
